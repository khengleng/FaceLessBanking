# accounting-service environment example
# Required: set these for every runtime environment.
SERVICE_NAME=accounting-service
NODE_ENV=development
PORT=3000

# Optional defaults (recommended for consistency).
HOST=0.0.0.0
LOG_LEVEL=info

# Required for this service.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/accounting_db
KAFKA_BROKERS=localhost:9092
