# admin-ops-service environment example
# Required: set these for every runtime environment.
SERVICE_NAME=admin-ops-service
NODE_ENV=development
PORT=3000

# Optional defaults (recommended for consistency).
HOST=0.0.0.0
LOG_LEVEL=info

# Required in shared/staging/prod.
# Local fallback exists in code, but do not rely on it outside local dev.
ADMIN_OPS_TOKEN=change-me-in-runtime
