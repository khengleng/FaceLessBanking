# customer-service environment example
# Required: set these for every runtime environment.
SERVICE_NAME=customer-service
NODE_ENV=development
PORT=3000

# Optional defaults (recommended for consistency).
HOST=0.0.0.0
LOG_LEVEL=info

# Required for this service.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/facelessbanking

# Optional (default exists in code).
REDIS_URL=redis://localhost:6379
