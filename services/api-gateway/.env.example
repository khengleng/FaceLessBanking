# api-gateway environment example
# Required: set these for every runtime environment.
SERVICE_NAME=api-gateway
NODE_ENV=development
PORT=3000

# Optional defaults (recommended for consistency).
HOST=0.0.0.0
LOG_LEVEL=info

# Optional in local dev (defaults exist), recommended to set explicitly.
CUSTOMER_SERVICE_URL=http://localhost:3001
ACCOUNT_SERVICE_URL=http://localhost:3002
LOAN_ORCHESTRATION_URL=http://localhost:3003
PAYMENT_ORCHESTRATION_URL=http://localhost:3004
EKYC_ORCHESTRATION_URL=http://localhost:3005
SUPPORT_CRM_SERVICE_URL=http://localhost:3006
