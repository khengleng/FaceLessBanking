# FaceLessBanking monorepo environment reference
# Copy values into real .env files per deployment target.
# Do not commit real secrets.

# ------------------------------------------------------------
# Shared baseline (recommended for all Node services)
# ------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000

# ------------------------------------------------------------
# Shared infrastructure (set where the service uses them)
# ------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/facelessbanking
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092

# ------------------------------------------------------------
# Internal service routing (mainly API Gateway)
# ------------------------------------------------------------
CUSTOMER_SERVICE_URL=http://localhost:3001
ACCOUNT_SERVICE_URL=http://localhost:3002
LOAN_ORCHESTRATION_URL=http://localhost:3003
PAYMENT_ORCHESTRATION_URL=http://localhost:3004
EKYC_ORCHESTRATION_URL=http://localhost:3005
SUPPORT_CRM_SERVICE_URL=http://localhost:3006

# ------------------------------------------------------------
# Domain-specific variables (only for relevant services)
# ------------------------------------------------------------
BALANCE_CACHE_KEY_PREFIX=balance:
BALANCE_CACHE_TTL_SECONDS=60
LOAN_FUNDING_ACCOUNT_ID=loan-funding-account
ADMIN_OPS_TOKEN=change-me-in-runtime
SUMSUB_WEBHOOK_SECRET=change-me-in-runtime

# ------------------------------------------------------------
# Standardization note
# ------------------------------------------------------------
# Existing code currently reads ADMIN_OPS_TOKEN directly.
# Keep using ADMIN_OPS_TOKEN until code introduces a shared alias.
