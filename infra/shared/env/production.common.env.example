# Shared production defaults (non-secret placeholders)
NODE_ENV=production
LOG_LEVEL=info
HOST=0.0.0.0

# Infra placeholders, injected from secret manager/runtime
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<db>
REDIS_URL=redis://<host>:6379
KAFKA_BROKERS=<broker1>:9092,<broker2>:9092,<broker3>:9092
